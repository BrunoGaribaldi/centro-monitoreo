# Copiar a .env y completar con valores reales. NO commitear .env.
# Generá una contraseña fuerte (ej: openssl rand -base64 24)
MEDIAMTX_PUBLISH_PASS=cambiar-esto-por-una-clave-fuerte

# Clave secreta para firmar los JWT del auth-service.
# Generar con: openssl rand -base64 32
# Si esta clave cambia, todos los tokens existentes quedan invalidados.
AUTH_SECRET_KEY=cambiar-esto-por-un-secreto-de-al-menos-32-chars
