# Copiar a .env y completar con valores reales. NO commitear .env.
# Generá secrets fuertes con: openssl rand -base64 64

# ---------------------------------------------------------------------
# MediaMTX — clave de publicación RTMP (hoy FlightHub 2 la ignora)
# ---------------------------------------------------------------------
MEDIAMTX_PUBLISH_PASS=cambiar-esto-por-una-clave-fuerte

# ---------------------------------------------------------------------
# Authelia — secrets de sesión, storage y reset password
# ---------------------------------------------------------------------
# Cada uno tiene que ser distinto y de al menos 64 chars random.
#   openssl rand -base64 64 | tr -d '\n'
#
# Si cambiás AUTHELIA_SESSION_SECRET → todas las sesiones quedan invalidadas.
# Si cambiás AUTHELIA_STORAGE_ENCRYPTION_KEY → el SQLite (db.sqlite3) se vuelve
# ilegible. No la cambies sin migrar la base.
AUTHELIA_SESSION_SECRET=cambiar-esto-por-un-secreto-largo
AUTHELIA_STORAGE_ENCRYPTION_KEY=cambiar-esto-por-otro-secreto-largo
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=cambiar-esto-por-otro-secreto-largo
